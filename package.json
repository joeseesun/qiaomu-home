{
  "name": "qiaomu-home",
  "version": "0.8.2",
  "description": "A calm start page for Obsidian: search, create, and continue what you were reading, listening to, or asking.",
  "license": "GPL-3.0-only",
  "private": true,
  "scripts": {
    "dev": "node esbuild.config.mjs --watch",
    "build": "tsc --noEmit && node esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "i18n:strings": "node scripts/i18n-strings.mjs",
    "check": "npm run lint && npm run test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "jsdom": "^30.0.1",
    "obsidian": "^1.13.1",
    "typescript": "^5.4.5",
    "vitest": "^5.0.0"
  }
}
